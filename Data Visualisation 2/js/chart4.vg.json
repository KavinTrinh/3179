{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia's Carbon Journey: State-by-State Evolution",
    "subtitle": "Three decades of emissions change across Australian states (1990-2023)",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "width": "container", 
  "autosize": {"type": "fit"},
  "height": 500,
  "params": [
    {
      "name": "Year_selection",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 1990,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [133, -28],
    "scale": 800
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/australia_state_emissions_long.csv"
      }
      ,
      "transform": [
        {
          "filter": "datum['Financial Year'] == Year_selection"
        },
        {
          "lookup": "State_Full_Name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/STE_2021_AUST.topojson",
              "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
            },
            "key": "properties.STE_NAME21"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "Emissions",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [5, 25, 50, 100, 150],
            "scheme": "orangered"
          },
          "legend": {
            "title": "Emissions (Mt CO2)"
          }
        },
        "tooltip": [
          {"field": "State_Full_Name", "type": "nominal", "title": "State"},
          {"field": "Financial Year", "type": "quantitative", "title": "Year"},
          {
            "field": "Emissions",
            "type": "quantitative",
            "title": "Total Emissions (Mt)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/STE_2021_AUST.topojson",
        "format": {"type": "topojson", "feature": "ne_10m_graticules_30"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "lightgray"}
    },
    {
      "data": {
        "values": [
          {"state": "WA", "longitude": 122, "latitude": -26},
          {"state": "NT", "longitude": 133, "latitude": -20},
          {"state": "QLD", "longitude": 145, "latitude": -22},
          {"state": "SA", "longitude": 135, "latitude": -30},
          {"state": "NSW", "longitude": 147, "latitude": -32},
          {"state": "VIC", "longitude": 144, "latitude": -37},
          {"state": "TAS", "longitude": 147, "latitude": -42}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "wwhite"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}