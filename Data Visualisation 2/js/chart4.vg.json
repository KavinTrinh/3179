{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia's Carbon Journey: State-by-State Evolution",
    "subtitle": "Three decades of emissions change across Australian states (1990-2023)",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "width": 800,
  "height": 500,
  "params": [
    {
      "name": "Year_selection",
      "value": 2023,
      "bind": {
        "input": "range",
        "min": 1990,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "projection": {
    "type": "equirectangular",
    "center": [133, -28],
    "scale": 800
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/STE_2021_AUST.topojson",
        "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/australia_state_emissions_long.csv"
            },
            "key": "State_Full_Name",
            "fields": ["Financial Year", "State_Code", "Emissions"]
          }
        },
        {
          "filter": "datum['Financial Year'] == Year_selection"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "Emissions",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [5, 25, 50, 100, 150],
            "scheme": "orangered"
          },
          "legend": {
            "title": "Emissions (Mt CO2)",
            "orient": "bottom-right",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "properties.STE_NAME21", "type": "nominal", "title": "State"},
          {"field": "Financial Year", "type": "quantitative", "title": "Year"},
          {
            "field": "Emissions",
            "type": "quantitative",
            "title": "Total Emissions (Mt)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}