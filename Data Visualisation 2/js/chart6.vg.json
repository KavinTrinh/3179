{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Energy Transition: Fossil vs Renewable Generation",
    "subtitle": "Electricity generation by source and state (2024)",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "width": 700,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/state_electricity_generation_2024.csv"
  },
  "transform": [
    {
      "fold": ["Fossil_GWh", "Renewable_GWh"],
      "as": ["Source", "Generation_GWh"]
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {"field": "Renewable_Percentage", "order": "descending"},
      "axis": {"labelAngle": 0}
    },
    "x": {
      "field": "Generation_GWh",
      "type": "quantitative",
      "title": "Electricity Generation (GWh)"
    },
    "color": {
      "field": "Source",
      "type": "nominal",
      "scale": {
        "domain": ["Fossil_GWh", "Renewable_GWh"],
        "range": ["#8c564b", "#2ca02c"]
      },
      "legend": {
        "title": "Energy Source",
        "labelExpr": "datum.value == 'Fossil_GWh' ? 'Fossil Fuels (Coal + Gas)' : 'Renewables'"
      }
    },
    "xOffset": {"field": "Source"},
    "tooltip": [
      {"field": "State", "type": "nominal", "title": "State"},
      {
        "field": "Generation_GWh",
        "type": "quantitative",
        "title": "Generation (GWh)",
        "format": ",.1f"
      },
      {
        "field": "Renewable_Percentage",
        "type": "quantitative",
        "title": "Renewable Share (%)",
        "format": ".1f"
      }
    ]
  }
}