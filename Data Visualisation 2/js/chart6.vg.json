{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australia's Energy Mix: A Tale of Two Transitions",
    "subtitle": "Comparing renewable and fossil fuel composition by state (2024)",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "width": "container", 
  "autosize": {"type": "fit"},
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/state_energy_detailed_2024.csv"
  },
  "spacing": 0,
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "hconcat": [
    {
    "title": "Renewable Energy",
    "width": 350,
    "transform": [
        {
        "joinaggregate": [
            {"op": "sum", "field": "Generation_GWh", "as": "Total_Generation"}
        ],
        "groupby": ["State"]
        },
        {
        "joinaggregate": [
            {"op": "sum", "field": "Generation_GWh", "as": "Category_Total"}
        ],
        "groupby": ["State", "Category"]
        },
        {
        "calculate": "(datum.Category_Total / datum.Total_Generation) * 100",
        "as": "Category_Percentage"
        },
        {"filter": "datum.Category == 'Renewable'"}
    ],
    "mark": "bar",
    "encoding": {
        "y": {
        "field": "State",
        "type": "nominal",
        "axis": null,
        "sort": ["TAS", "SA", "VIC", "NSW", "QLD", "WA", "NT"]
        },
        "x": {
        "field": "Generation_GWh",
        "type": "quantitative",
        "title": "Renewable Generation (GWh)",
        "sort": "descending",
        "axis": {"orient": "top"}
        },
        "color": {
        "field": "Fuel_Type",
        "type": "nominal",
        "scale": {
            "domain": ["Solar", "Wind", "Hydro", "Biomass"],
            "range": ["#ffd700", "#87ceeb", "#1e90ff", "#90ee90"]
        },
        "legend": {
            "title": "Renewable Type",
            "orient": "bottom"
        }
        },
        "tooltip": [
        {"field": "State", "type": "nominal", "title": "State"},
        {"field": "Fuel_Type", "type": "nominal", "title": "Fuel Type"},
        {
            "field": "Generation_GWh",
            "type": "quantitative",
            "title": "Generation (GWh)",
            "format": ",.0f"
        },
        {
            "field": "Category_Percentage",
            "type": "quantitative",
            "title": "% of State Total",
            "format": ".1f"
        }
        ]
    }
    },
    {
      "title": "Fossil Fuel Energy",
      "width": 350,
      "transform": [
        {"filter": "datum.Category == 'Non-Renewable'"}
      ],
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "State",
          "type": "nominal",
          "axis": null,
          "sort": ["TAS", "SA", "VIC", "NSW", "QLD", "WA", "NT"]
        },
        "x": {
          "field": "Generation_GWh",
          "type": "quantitative",
          "title": "Fossil Fuel Generation (GWh)",
          "axis": {"orient": "top"}
        },
        "color": {
          "field": "Fuel_Type",
          "type": "nominal",
          "scale": {
            "domain": ["Black coal", "Brown coal", "Natural gas", "Oil products"],
            "range": ["#2C3E50", "#D2691E", "#E74C3C", "#F39C12"]
          },
          "legend": {
            "title": "Fossil Fuel Type",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Fuel_Type", "type": "nominal", "title": "Fuel Type"},
          {
            "field": "Generation_GWh",
            "type": "quantitative",
            "title": "Generation (GWh)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}