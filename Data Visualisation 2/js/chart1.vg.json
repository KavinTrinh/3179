{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global CO2 Emissions per Capita Over Time",
    "subtitle": "Australia highlighted among the world's highest per capita emitters",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start",
    "color": "#333",
    "subtitleColor": "#666"
  },
  "width": 800,
  "height": 450,
  "params": [
    {
      "name": "Year_selection",
      "value": 2022,
      "bind": {
        "input": "select",
        "options": [1970, 1980, 1990, 2000, 2010, 2015, 2020, 2022],
        "name": "Year: "
      }
    },
    {
      "name": "zoom_level",
      "value": 150,
      "bind": {
        "input": "range",
        "min": 150,
        "max": 1000,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "center_to",
      "value": [0, 0],
      "bind": {
        "input": "select",
        "options": [
          [0, 0],
          [133, -27],
          [-95, 37],
          [10, 50],
          [105, 35],
          [25, 0]
        ],
        "labels": [
          "World",
          "Australia",
          "North America",
          "Europe",
          "Asia",
          "Africa"
        ],
        "name": "Map Centre: "
      }
    }
  ],
  "projection": {
    "type": "equalEarth",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom_level"}
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "#e8f4f8"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/WorldMapWithGraticules.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "#ddd", "strokeWidth": 0.5}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [
        {
          "calculate": "'Data is not available for ' + datum.properties.NAME",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ddd",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "tooltip": {"field": "note"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/co2_emissions_per_capita_timeseries.csv"
      },
      "transform": [
        {
          "filter": "datum.Year == Year_selection"
        },
        {
          "lookup": "Code",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/ne_110m_admin_0_countries.topojson",
              "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "key": "properties.ADM0_A3"
          },
          "as": "geo"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#fff", "strokeWidth": 0.5},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "Emissions_per_Capita",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [2, 5, 10, 15, 20],
            "scheme": "oranges"
          },
          "legend": {
            "title": "CO₂ per Capita (tons/person)",
            "orient": "bottom-right",
            "direction": "horizontal",
            "titleLimit": 250,
            "format": ".1f"
          }
        },
        "tooltip": [
          {"field": "Entity", "type": "nominal", "title": "Country"},
          {"field": "Year", "type": "quantitative", "title": "Year"},
          {
            "field": "Emissions_per_Capita",
            "type": "quantitative",
            "title": "Per Capita Emissions (tons)",
            "format": ".2f"
          },
          {
            "field": "Annual_CO2_emissions",
            "type": "quantitative",
            "title": "Total Emissions (tons)",
            "format": ",.0f"
          },
          {
            "field": "Population",
            "type": "quantitative",
            "title": "Population",
            "format": ",.0f"
          },
          {
            "field": "Continent",
            "type": "nominal",
            "title": "Continent"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/co2_emissions_per_capita_timeseries.csv"
      },
      "transform": [
        {
          "filter": "datum.Code == 'AUS'"
        },
        {
          "filter": "datum.Year == Year_selection"
        },
        {
          "lookup": "Code",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/js/ne_110m_admin_0_countries.topojson",
              "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "key": "properties.ADM0_A3"
          },
          "as": "geo"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#000",
        "strokeWidth": 2.5
      },
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}