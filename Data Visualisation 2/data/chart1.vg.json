{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Global CO2 Emissions per Capita (2023)",
    "subtitle": "Australia highlighted among the world's highest per capita emitters",
    "fontSize": 20,
    "subtitleFontSize": 14,
    "anchor": "start",
    "color": "#333",
    "subtitleColor": "#666"
  },
  "width": 800,
  "height": 450,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/Co2_Emissions_by_Sectors.csv"
            },
            "key": "Country",
            "fields": ["Co2_Emissions_MetricTons", "Population_Millions", "GDP_Billion_USD", "Region"]
          }
        },
        {
          "calculate": "datum.Co2_Emissions_MetricTons / datum.Population_Millions",
          "as": "Emissions_per_Capita"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "#fff", "strokeWidth": 0.5},
      "encoding": {
        "color": {
          "field": "Emissions_per_Capita",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [5, 10, 15, 20],
            "scheme": "oranges"
          },
          "legend": {
            "title": "CO2 per Capita (tons)",
            "orient": "bottom-right",
            "direction": "horizontal",
            "titleLimit": 200
          }
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "Country"},
          {
            "field": "Emissions_per_Capita",
            "type": "quantitative",
            "title": "Per Capita Emissions (tons)",
            "format": ".2f"
          },
          {
            "field": "Co2_Emissions_MetricTons",
            "type": "quantitative",
            "title": "Total Emissions (MT)",
            "format": ",.0f"
          },
          {
            "field": "Population_Millions",
            "type": "quantitative",
            "title": "Population (millions)",
            "format": ".1f"
          },
          {
            "field": "GDP_Billion_USD",
            "type": "quantitative",
            "title": "GDP (billion USD)",
            "format": ",.0f"
          },
          {"field": "Region", "type": "nominal", "title": "Region"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/KavinTrinh/3179/refs/heads/main/Data%20Visualisation%202/data/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [
        {
          "filter": "datum.properties.NAME == 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#000",
        "strokeWidth": 2
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {"type": "topojson", "feature": "oceans"}
      },
      "mark": {"type": "geoshape", "fill": "#e8f4f8"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_graticules_30"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "#ddd", "strokeWidth": 0.5}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Arial"
  }
}